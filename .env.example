# Copy this template to the project-root .env or configure hosting Variables.
# Process/platform variables take precedence over .env values.
# Use python -m app.set_secret NAME for hidden local secret entry. Never share keys in chat.
DEMO_MODE=true
AI_PROVIDER=openai
# Only the selected provider's key and model are required for live mode.
OPENAI_API_KEY=
# Select a model available in your project that supports Responses structured outputs.
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Required in live mode: at least 32 random characters, entered by users in the UI.
APP_ACCESS_TOKEN=
# Required in live mode: client-owned HTTPS Incoming Webhook accepting a JSON text field.
OWNER_WEBHOOK_URL=
API_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=2000
REQUESTS_PER_MINUTE=10
CACHE_TTL_HOURS=24
# Relative paths are resolved from the process working directory.
DATABASE_PATH=data/requests.sqlite3
REFERENCE_DIR=reference_docs
